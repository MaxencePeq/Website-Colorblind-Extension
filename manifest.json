{
  "manifest_version": 3,
  "name": "WebSite for Colorblind",
  "version": "1.1",
  "description": "Corrige les couleurs des pages web pour les personnes daltoniennes.",
  "icons": {},
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/favicon16.ico"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["daltonisation.js", "content.js"]
    }
  ],
  "permissions": ["storage"]
}
